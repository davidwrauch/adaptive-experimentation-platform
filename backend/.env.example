APP_ENV=local
DATABASE_URL=postgresql+psycopg2://adaptive:adaptive@localhost:5432/adaptive
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=true
DEMO_SEED_SIZE=25000
ADMIN_RESEED_TOKEN=replace-with-a-long-random-demo-token

# Optional local Redpanda/Kafka scaffold
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional only. The app works without external LLM calls.
ENABLE_OPTIONAL_LLM_GENERATION=false
OPENAI_API_KEY=
